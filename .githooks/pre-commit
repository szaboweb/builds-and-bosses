#!/usr/bin/env sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File tooling/validate_quality.ps1 -Staged -BaseRef HEAD
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/validate_quality.ps1 -Staged -BaseRef HEAD
else
  echo "Architecture hook requires pwsh or powershell.exe" >&2
  exit 1
fi