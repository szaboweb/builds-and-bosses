{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hero_save/v1",
  "type": "object",
  "required": ["_schema", "name", "class_levels", "attributes"],
  "properties": {
    "_schema": { "const": "hero_save/v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "class_levels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "attributes": { "$ref": "hero_defaults.v1.schema.json#/$defs/attributes" }
  },
  "additionalProperties": true
}