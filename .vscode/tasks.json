{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Check code quality ratchet",
			"type": "shell",
			"command": "powershell.exe",
			"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tooling\\validate_quality.ps1", "-Dart", "C:\\src\\flutter\\bin\\dart.bat"],
			"problemMatcher": []
		},
		{
			"label": "Inspect training arena in Chrome",
			"type": "shell",
			"command": "C:\\src\\flutter\\bin\\flutter.bat",
			"options": {
				"cwd": "${workspaceFolder}\\app",
				"shell": {
					"executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
					"args": ["-NoProfile", "-Command"]
				}
			},
			"args": [
				"run",
				"-d",
				"chrome",
				"--web-port",
				"7357",
				"--target",
				"lib\\main.dart"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}